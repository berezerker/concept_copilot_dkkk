# ── Провайдер по умолчанию в интерфейсе: mock | openai | gigachat
CF_DEFAULT_PROVIDER=mock

# ── OpenAI или любой совместимый API (vLLM, Ollama, LM Studio, внутренний шлюз)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4
# быстрее и дешевле, но слабее в выводах: gpt-4.1, gpt-5.4-mini
# OPENAI_TEMPERATURE=0.1
# OPENAI_CA_BUNDLE=C:\certs\corp_root.pem
# OPENAI_VERIFY_SSL=true

# ── GigaChat
# Ключ авторизации из личного кабинета (Base64 от client_id:client_secret)
GIGACHAT_CREDENTIALS=
# или готовый токен (например, от внутреннего шлюза) — тогда OAuth не используется
GIGACHAT_ACCESS_TOKEN=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Сертификат НУЦ Минцифры (russian_trusted_root_ca.cer) — путь к файлу:
GIGACHAT_CA_BUNDLE=
# GIGACHAT_VERIFY_SSL=false   # только для локальных экспериментов

# ── Движок пересчёта: auto | excel | libreoffice | none
#   auto (по умолчанию): Excel через xlwings, при неудаче — LibreOffice (запасной вариант)
CF_ENGINE=auto
# Для LibreOffice, если не найден автоматически:
# CF_SOFFICE=/Applications/LibreOffice.app/Contents/MacOS/soffice

# ── Сервер
CF_HOST=127.0.0.1
CF_PORT=8000
CF_OPEN_BROWSER=1
# CF_WORKDIR=./workspace
# CF_SEM_MAX_ROWS=1500      # сколько строк LLM описывает при смысловом разборе

# ── Excel (тонкая настройка, обычно не нужна)
# CF_EXCEL_VISIBLE=0        # 1 — не скрывать Excel во время работы
# CF_MAC_BATCH=1            # Mac: запись шоков одним AppleScript (0 — по одной записи)
# CF_CALC_PASSES=1          # проходы пересчёта для моделей без циклов
# CF_CALC_MODE=calc         # full — CalculateFull (медленнее)

# ── Демо и тесты
# CF_RECORD=0               # 1 — записывать сеанс для demo.html (обычно через record_demo.command)
# CF_EVAL_PROVIDER=openai   # LLM агента в E2E-тестах
# CF_EVAL_JUDGE=openai      # LLM-судья в E2E-тестах
